{
  "schema_version": "1.0.0",
  "tier": "B_library",
  "id": "sdpa_forward_b_v0",
  "name": "SDPA forward library dispatch",
  "family": "sdpa_forward",
  "source": {
    "project": "attention-source-001",
    "revision": "snapshot-20260901",
    "license": "maintainer-verified-open-source",
    "record": "sources/attention-source-001.json",
    "snapshot_location": "outside this repository; see the source record",
    "snapshot_revision": "2026-09-01"
  },
  "target_environment": {
    "device_families": ["MTT S4000", "MTT S5000"],
    "architectures": ["mp_22", "mp_31"],
    "toolkit_constraint": "exact version is fixed by the active environment snapshot"
  },
  "tensor_contract": {
    "input_dtypes": ["float16", "bfloat16"],
    "accumulation_dtype": "float32",
    "layouts": ["BHSD"],
    "dynamic_axes": ["B", "H_q", "H_kv", "S_q", "S_kv", "D"]
  },
  "hyperparameters": {
    "scale": "inverse_sqrt_d_or_case_value",
    "causal_alignment": "top_left",
    "window_unlimited_value": -1
  },
  "tolerances": {"atol": 0.01, "rtol": 0.01, "max_abs_error": 0.05},
  "prohibited": ["non-whitelisted libraries", "ATen", "CUDA residue", "host-side tensor math", "network fetch", "version-string dispatch"],
  "submission": {
    "entrypoint": "ModelNew",
    "language": "python",
    "fallback_kernel": "musa_inline",
    "note": "KernelBench-style submission: a Python module defining ModelNew. fused_library and library_composition call torch_musa / muDNN directly; custom_fallback may JIT-compile a .mu kernel through kernelbench.musa_extension.load_inline."
  },
  "problem_file": "problem.py",
  "reference": "problem.py:Model",
  "case_parameters": {
    "attributes.scale": "default_scale",
    "attributes.causal": "default_causal",
    "attributes.window_left": "default_window_left",
    "attributes.window_right": "default_window_right",
    "shape.B": "batch_size",
    "shape.H_q": "num_query_heads",
    "shape.H_kv": "num_kv_heads",
    "shape.S_q": "sequence_length_query",
    "shape.S_kv": "sequence_length_key",
    "shape.D": "head_dimension"
  },
  "attempt_budget": {"max_attempts": 20, "wall_time_seconds": 7200},
  "outputs": {"required": ["output", "dispatch_trace"], "optional": ["lse"]},
  "library_policy": {
    "allowed_libraries": ["libmusa", "libmudnn"],
    "allowed_symbol_prefixes": ["musa", "mudnn"],
    "required_trace_fields": ["case_id", "selected_path", "probe_status"],
    "trace_env_var": "KB_DISPATCH_TRACE",
    "minimum_gap_cases": 3,
    "required_gap_reasons": ["unsupported_dtype", "unsupported_shape", "semantic_mismatch"]
  }
}
