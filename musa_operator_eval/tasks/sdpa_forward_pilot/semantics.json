{
  "schema_version": "1.0.0",
  "family": "sdpa_forward",
  "operation": "sdpa_forward",
  "tensors": [
    {"name": "q", "role": "input", "shape": ["B", "H_q", "S_q", "D"], "dtypes": ["float16", "bfloat16"], "layout": "BHSD", "stride": "contiguous"},
    {"name": "k", "role": "input", "shape": ["B", "H_kv", "S_kv", "D"], "dtypes": ["float16", "bfloat16"], "layout": "BHSD", "stride": "contiguous"},
    {"name": "v", "role": "input", "shape": ["B", "H_kv", "S_kv", "D"], "dtypes": ["float16", "bfloat16"], "layout": "BHSD", "stride": "contiguous"},
    {"name": "output", "role": "output", "shape": ["B", "H_q", "S_q", "D"], "dtypes": ["float16", "bfloat16"], "layout": "BHSD", "stride": "contiguous"}
  ],
  "outputs_note": "One output only. A log-sum-exp would be a second output, and the harness compares exactly one tensor; more importantly the library's fused kernel does not produce one, so requiring it would close the fused path this task exists to exercise.",
  "dynamic_axes": {"B": [1, 32], "H_q": [1, 64], "H_kv": [1, 64], "S_q": [1, 4096], "S_kv": [1, 4096], "D": [32, 256]},
  "abi": {"passing": "in_process_torch_tensors", "layout": "contiguous", "stream": "current_musa_stream", "note": "runner is a ModelNew module evaluated in the same process as the reference"},
  "attention": {
    "scale": "case_value",
    "softmax_max_shift": true,
    "accumulation_dtype": "float32",
    "causal_alignment": "top_left",
    "window": {"left": "case.window_left", "right": "case.window_right", "unlimited_value": -1},
    "fully_masked_row": {"output": "zeros"}
  },
  "determinism": {"required": true, "seed_source": "case_manifest"}
}
