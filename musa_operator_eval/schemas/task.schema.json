{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kernelbench.local/musa/schemas/task-1.0.0.json",
  "title": "MUSA operator task contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "tier", "id", "name", "family", "source",
    "target_environment", "tensor_contract", "tolerances", "prohibited",
    "entrypoint", "editable_files", "attempt_budget", "outputs"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "tier": {"enum": ["A_kernel", "B_library"]},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]+$"},
    "name": {"type": "string", "minLength": 3},
    "family": {"type": "string", "minLength": 2},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "revision", "license", "snapshot"],
      "properties": {
        "project": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 7},
        "license": {"type": "string", "minLength": 2},
        "snapshot": {"type": "string", "minLength": 3}
      }
    },
    "target_environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device_families", "architectures", "toolkit_constraint"],
      "properties": {
        "device_families": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "architectures": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["mp_22", "mp_31"]}},
        "toolkit_constraint": {"type": "string", "minLength": 1}
      }
    },
    "tensor_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_dtypes", "accumulation_dtype", "layouts", "dynamic_axes"],
      "properties": {
        "input_dtypes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["float16", "bfloat16", "float32"]}},
        "accumulation_dtype": {"enum": ["float32", "float64"]},
        "layouts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "dynamic_axes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "hyperparameters": {"type": "object"},
    "tolerances": {
      "type": "object",
      "additionalProperties": false,
      "required": ["atol", "rtol", "max_abs_error"],
      "properties": {
        "atol": {"type": "number", "minimum": 0},
        "rtol": {"type": "number", "minimum": 0},
        "max_abs_error": {"type": "number", "minimum": 0}
      }
    },
    "prohibited": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "entrypoint": {"type": "string", "minLength": 1},
    "editable_files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "attempt_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_attempts", "wall_time_seconds"],
      "properties": {
        "max_attempts": {"type": "integer", "minimum": 1},
        "wall_time_seconds": {"type": "integer", "minimum": 1}
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "optional"],
      "properties": {
        "required": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "optional": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "library_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_libraries", "allowed_symbol_prefixes", "dispatch_file", "required_trace_fields", "minimum_gap_cases", "required_gap_reasons"],
      "properties": {
        "allowed_libraries": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "allowed_symbol_prefixes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "dispatch_file": {"type": "string", "minLength": 1},
        "required_trace_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "minimum_gap_cases": {"type": "integer", "minimum": 3},
        "required_gap_reasons": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"enum": ["unsupported_shape", "semantic_mismatch", "layout_mismatch", "multi_operator_required"]}}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"tier": {"const": "A_kernel"}}},
      "then": {"not": {"required": ["library_policy"]}},
      "else": {"required": ["library_policy"]}
    }
  ]
}
