{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kernelbench.local/musa/schemas/cases-1.0.0.json",
  "title": "MUSA evaluation case manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "tier", "visibility", "cases"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "task_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]+$"},
    "tier": {"enum": ["A_kernel", "B_library"]},
    "visibility": {"enum": ["public", "private"]},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "tag", "seed", "dtype", "shape", "attributes", "distribution", "tolerance", "golden"],
        "properties": {
          "case_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]+$"},
          "tag": {"enum": ["smoke", "correctness", "boundary", "non_aligned", "extreme", "perf", "generalization"]},
          "seed": {"type": "integer", "minimum": 0},
          "dtype": {"enum": ["float16", "bfloat16", "float32"]},
          "shape": {
            "type": "object",
            "additionalProperties": false,
            "required": ["B", "H_q", "H_kv", "S_q", "S_kv", "D"],
            "properties": {
              "B": {"type": "integer", "minimum": 1}, "H_q": {"type": "integer", "minimum": 1},
              "H_kv": {"type": "integer", "minimum": 1}, "S_q": {"type": "integer", "minimum": 1},
              "S_kv": {"type": "integer", "minimum": 1}, "D": {"type": "integer", "minimum": 1}
            }
          },
          "attributes": {"type": "object"},
          "distribution": {"enum": ["normal", "uniform", "adversarial_extremes"]},
          "tolerance": {
            "type": "object", "additionalProperties": false, "required": ["atol", "rtol"],
            "properties": {"atol": {"type": "number", "minimum": 0}, "rtol": {"type": "number", "minimum": 0}}
          },
          "golden": {"type": "string", "minLength": 1},
          "performance": {
            "type": "object", "additionalProperties": false, "required": ["warmup", "measurements", "rounds", "statistic"],
            "properties": {
              "warmup": {"type": "integer", "minimum": 1}, "measurements": {"type": "integer", "minimum": 1},
              "rounds": {"type": "integer", "minimum": 1}, "statistic": {"enum": ["median", "p50"]}
            }
          },
          "expected_path": {"enum": ["fused_library", "library_composition", "custom_fallback"]},
          "library_gap": {
            "type": "object", "additionalProperties": false, "required": ["reason", "expected_path", "evidence"],
            "properties": {
              "reason": {"enum": ["unsupported_shape", "semantic_mismatch", "layout_mismatch", "multi_operator_required"]},
              "expected_path": {"enum": ["library_composition", "custom_fallback"]},
              "evidence": {"type": "string", "minLength": 3}
            }
          }
        }
      }
    }
  }
}
