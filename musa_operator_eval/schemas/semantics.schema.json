{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kernelbench.local/musa/schemas/semantics-1.0.0.json",
  "title": "Attention semantic contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "family", "operation", "tensors", "dynamic_axes", "abi", "attention", "determinism"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "family": {"type": "string", "minLength": 2},
    "operation": {"const": "sdpa_forward"},
    "tensors": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "role", "shape", "dtypes", "layout", "stride"],
        "properties": {
          "name": {"type": "string"},
          "role": {"enum": ["input", "output", "optional_input", "optional_output"]},
          "shape": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "dtypes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["float16", "bfloat16", "float32"]}},
          "layout": {"enum": ["BHSD", "BSHD"]},
          "stride": {"enum": ["contiguous", "explicit_in_manifest"]}
        }
      }
    },
    "dynamic_axes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["B", "H_q", "H_kv", "S_q", "S_kv", "D"],
      "properties": {
        "B": {"type": "array", "minItems": 2, "items": {"type": "integer", "minimum": 1}},
        "H_q": {"type": "array", "minItems": 2, "items": {"type": "integer", "minimum": 1}},
        "H_kv": {"type": "array", "minItems": 2, "items": {"type": "integer", "minimum": 1}},
        "S_q": {"type": "array", "minItems": 2, "items": {"type": "integer", "minimum": 1}},
        "S_kv": {"type": "array", "minItems": 2, "items": {"type": "integer", "minimum": 1}},
        "D": {"type": "array", "minItems": 2, "items": {"type": "integer", "minimum": 1}}
      }
    },
    "abi": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "manifest", "allocation_owner", "stream"],
      "properties": {
        "format": {"const": "raw_binary"},
        "manifest": {"const": "tensors.json"},
        "allocation_owner": {"const": "runner"},
        "stream": {"const": "current_musa_stream"}
      }
    },
    "attention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scale", "softmax_max_shift", "accumulation_dtype", "causal_alignment", "window", "fully_masked_row"],
      "properties": {
        "scale": {"enum": ["inverse_sqrt_d", "case_value"]},
        "softmax_max_shift": {"const": true},
        "accumulation_dtype": {"const": "float32"},
        "causal_alignment": {"enum": ["top_left", "bottom_right"]},
        "window": {
          "type": "object",
          "additionalProperties": false,
          "required": ["left", "right", "unlimited_value"],
          "properties": {
            "left": {"type": "string"},
            "right": {"type": "string"},
            "unlimited_value": {"const": -1}
          }
        },
        "fully_masked_row": {
          "type": "object",
          "additionalProperties": false,
          "required": ["output", "lse"],
          "properties": {
            "output": {"const": "zeros"},
            "lse": {"const": "negative_infinity"}
          }
        }
      }
    },
    "determinism": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "seed_source"],
      "properties": {
        "required": {"const": true},
        "seed_source": {"const": "case_manifest"}
      }
    }
  }
}
