{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kernelbench.local/musa/schemas/baseline-1.0.0.json",
  "title": "MUSA task baseline results",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "tier", "environment_snapshot", "measurement_protocol", "implementations", "results", "scoring"],
  "properties": {
    "schema_version": {"const": "1.0.0"}, "task_id": {"type": "string"}, "tier": {"enum": ["A_kernel", "B_library"]},
    "environment_snapshot": {"type": "string", "minLength": 1},
    "measurement_protocol": {"type": "object", "required": ["warmup", "measurements", "rounds", "statistic", "timer", "clock_locked"], "properties": {"warmup": {"type": "integer", "minimum": 1}, "measurements": {"type": "integer", "minimum": 1}, "rounds": {"type": "integer", "minimum": 1}, "statistic": {"const": "median"}, "timer": {"const": "musa_event"}, "clock_locked": {"type": "boolean"}}},
    "implementations": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"type": "string"}},
    "results": {"type": "array", "items": {"type": "object", "required": ["case_id", "implementation", "status", "latency_ms", "throughput", "peak_memory_bytes", "numeric"], "properties": {"case_id": {"type": "string"}, "implementation": {"type": "string"}, "status": {"enum": ["pass", "fail", "unsupported"]}, "latency_ms": {"type": ["number", "null"]}, "throughput": {"type": ["number", "null"]}, "peak_memory_bytes": {"type": ["integer", "null"]}, "numeric": {"type": "object"}}}},
    "scoring": {"type": "object", "required": ["speedup_denominator", "correctness_gate"], "properties": {"speedup_denominator": {"type": "string"}, "reference_implementation": {"type": "string"}, "correctness_gate": {"const": "all_hidden_cases"}, "minimum_naive_to_expert_ratio": {"type": "number", "minimum": 1.3}}}
  }
}
