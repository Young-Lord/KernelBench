{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kernelbench.local/musa/schemas/baseline-1.0.0.json",
  "title": "MUSA task baseline (private/*/baseline.json)",
  "description": "Guide §4.4. A baseline is only meaningful against the environment it was measured in, so the snapshot id is required and every row has to say which implementation it belongs to. The B tier adds two implementations that the A tier does not have -- the naive library composition (the lower bound) and the expert dispatch (the speedup denominator), so for B_library the scoring denominator is pinned to the expert dispatch.",
  "$defs": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "implementation",
        "status"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "implementation": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "unavailable",
            "unsupported"
          ]
        },
        "latency_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "throughput": {
          "type": [
            "number",
            "null"
          ]
        },
        "peak_memory_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "numeric": {
          "type": "object"
        },
        "reason": {
          "type": "string"
        },
        "dtype": {
          "type": "string",
          "minLength": 1
        },
        "dispatch_trace_passed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "recorded_paths": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "The paths the implementation's own trace reported. Recorded so a mismatch can be read without re-running; null when nothing was recorded."
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "tier",
    "environment_snapshot",
    "measurement_protocol",
    "implementations",
    "results",
    "scoring"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_]*$"
    },
    "tier": {
      "enum": [
        "A_kernel",
        "B_library"
      ]
    },
    "environment_snapshot": {
      "type": "string",
      "minLength": 3
    },
    "measurement_protocol": {
      "type": "object",
      "required": [
        "warmup",
        "measurements",
        "rounds",
        "statistic"
      ],
      "properties": {
        "warmup": {
          "type": "integer",
          "minimum": 1
        },
        "measurements": {
          "type": "integer",
          "minimum": 1
        },
        "rounds": {
          "type": "integer",
          "minimum": 1
        },
        "statistic": {
          "type": "string",
          "minLength": 1
        },
        "timer": {
          "type": "string",
          "minLength": 1
        },
        "clock_locked": {
          "type": "boolean"
        }
      }
    },
    "weight_alignment": {
      "type": "string"
    },
    "tolerance_source": {
      "type": "string"
    },
    "implementations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/result"
      }
    },
    "scoring": {
      "type": "object",
      "required": [
        "speedup_denominator",
        "correctness_gate"
      ],
      "properties": {
        "speedup_denominator": {
          "type": "string",
          "minLength": 1
        },
        "reference_implementation": {
          "type": "string"
        },
        "correctness_gate": {
          "const": "all_hidden_cases"
        },
        "minimum_naive_to_expert_ratio": {
          "type": "number",
          "minimum": 1.3
        }
      }
    },
    "declared_tolerance": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "description": "The task's own `tolerances.max_abs_error`, which the resolver takes as a loosen-only override."
    },
    "resolved_tolerances": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      },
      "description": "What the tolerance resolved to per dtype for this run, so a `max_abs_diff exceeds` row can be read without looking up the framework's table."
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "tier"
        ],
        "properties": {
          "tier": {
            "const": "B_library"
          }
        }
      },
      "then": {
        "properties": {
          "implementations": {
            "allOf": [
              {
                "not": {
                  "items": {
                    "not": {
                      "const": "naive_library_composition"
                    }
                  }
                }
              },
              {
                "not": {
                  "items": {
                    "not": {
                      "const": "expert_dispatch"
                    }
                  }
                }
              },
              {
                "not": {
                  "items": {
                    "not": {
                      "const": "upstream_musa"
                    }
                  }
                }
              },
              {
                "not": {
                  "items": {
                    "not": {
                      "const": "mudnn_fused"
                    }
                  }
                }
              }
            ]
          },
          "scoring": {
            "properties": {
              "speedup_denominator": {
                "const": "expert_dispatch"
              }
            }
          }
        }
      }
    }
  ]
}
